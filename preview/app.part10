//  Supabase Dashboard → Project Settings → API → URL / anon public key
// ════════════════════════════════════════════════════════════════════════════
const SUPABASE_URL      = 'https://ryqsxtnjdrltuocqszge.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_inW_Tg6O_bKA3u0d2hc6dQ_CtRQKWn0';
const db = (SUPABASE_URL !== 'YOUR_SUPABASE_URL')
  ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      auth: { persistSession: true, autoRefreshToken: true }
    })
  : null;   // null = offline / unconfigured mode — auth gate skips to login form

