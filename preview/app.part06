" alt="CCBCU Logo" style="height:46px;width:46px;border-radius:50%;border:2px solid rgba(255,255,255,0.85);flex-shrink:0;">
    </div>
    <div>
      <div class="hdr-title">Route Optimizer</div>
      <div class="hdr-sub" id="hdr-dc-subtitle"></div>
    </div>
  </div>
  <div class="hdr-right">
    <div class="hdr-user no-print">
      <span class="hdr-user-email" id="hdr-user-email"></span>
      <span id="commit-badge" class="no-print" style="display:none">🔒 Committed</span>
      <span id="sync-indicator" class="synced" style="display:none"></span>
      <button class="hdr-logout-btn" id="hdr-dispatchers-btn" onclick="openDispatchers()" style="display:none">👥 Dispatchers</button>
      <button class="hdr-logout-btn" id="hdr-logout-btn" onclick="handleSignOut()" style="display:none">Sign Out</button>
    </div>
    <div class="hdr-date">
      <strong id="hdr-date"></strong>
      <span id="hdr-day"></span>
    </div>
    <button class="hdr-settings-btn no-print" id="btn-settings-gear" onclick="openSettings()" title="Settings" style="display:none">⚙</button>
    <div class="dc-switcher no-print" id="dc-switcher">
      <button class="hdr-settings-btn" onclick="toggleDCSwitcher(event)" title="Switch DC" style="font-size:15px;">⇄</button>
      <div class="dc-switcher-dropdown" id="dc-switcher-dropdown"></div>
    </div>
  </div>
</header>

<!-- ── AUTH GATE ──────────────────────────────────────────── -->
<div id="auth-gate">
  <div class="auth-loading" id="auth-loading">
    <div class="auth-spinner"></div>
    <div>Loading…</div>
  </div>
  <div class="auth-card" id="auth-card" style="display:none">
    <div class="auth-card-hdr">
      <div class="auth-card-badge">CCBCU</div>
      <div>
        <div class="auth-card-title">Route Optimizer</div>
        <div class="auth-card-sub" id="auth-dc-name"></div>
      </div>
    </div>
    <div class="auth-h2" id="auth-h2">Sign In</div>
    <form id="auth-form" onsubmit="handleSignIn(event)">
      <div class="auth-field">
        <label for="auth-email">Email</label>
        <input type="email" id="auth-email" placeholder="your@email.com" required autocomplete="email">
      </div>
      <div class="auth-field">
        <label for="auth-password">Password</label>
        <input type="password" id="auth-password" placeholder="Password" required autocomplete="current-password">
      </div>
      <button type="submit" id="auth-submit-btn" class="auth-submit">Sign In</button>
    </form>
    <div id="auth-error" class="auth-error"></div>
    <div id="auth-info" style="display:none;font-size:12px;color:#1e8449;margin-top:8px;"></div>
    <div style="text-align:center;margin-top:12px;font-size:12px;color:var(--gray-500,#888);">
      <span id="auth-mode-prompt">New dispatcher?</span>
      <a href="#" id="auth-mode-toggle" onclick="toggleAuthMode(event)" style="color:var(--red,#E61D2B);font-weight:600;text-decoration:none;">Create an account</a>
    </div>
  </div>
</div>

<!-- ═══ TABS ════════════════════════════════════════════════════════════ -->
<div class="tab-bar no-print">
  <button class="tab-btn active" onclick="switchTab('dashboard', event)">Dashboard</button>
  <button class="tab-btn" onclick="switchTab('fleet', event)">Drivers</button>
  <button class="tab-btn" onclick="switchTab('history', event)">History</button>
</div>

<!-- ═══ TAB: DASHBOARD ══════════════════════════════════════════════════ -->
<div id="tab-dashboard" class="tab-content active">
  <div style="max-width: 1350px; margin: 0 auto;">
    <div class="stack">

      <!-- Phase Inputs -->
      <div class="card" style="overflow:hidden;">
        <div class="card-heade