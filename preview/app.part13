 => {});
    _user = null;
  }

  // ── Day sync (debounced 3 s) ─────────────────────────────────────────────
  function queueSync() {
    clearTimeout(_dayTimer);
    _dayTimer = setTimeout(_syncDay, 3000);
    _setSyncIndicator('syncing');
  }

  async function _syncDay() {
    if (!db || !_user) return;
    // Key dispatch_days by the LOCAL (browser) date, not UTC. Each DC's dispatchers sit in
    // that DC's timezone (Montgomery=Central, Tifton=Eastern), so local date = the operational
    // day. Using UTC made evening work (past UTC midnight = ~7-8pm local) bleed onto the next
    // day's row, blocking the nightly reset. The nightly cron runs 08:00 UTC = 3-4am local, when
    // local date == UTC date, so client and cron stay aligned at the day boundary.
    const today = todayLocal();
    try {
      const { error } = await db.rpc('save_dispatch_day', {
        p_dc_slug:            DC_CONFIG.id,
        p_date:               today,
        p_loads:              state.loads,
        p_result:             state.lastResult,
        p_settings:           state.settings,
        p_ad_hoc:             state.adhocMoves,
        p_bucket_assignments: state.bucketAsgn,
        p_returned:           state.returned,
        p_what_if:            state.whatIf,
        p_templates:          state.templates,
      });
      if (error) throw error;
      _setSyncIndicator('synced');
    } catch(e) {
      console.error('[SupabaseSync] _syncDay failed:', e);
      _setSyncIndicator('offline');
    }
  }

  // ── DC config sync (custom DCs only, debounced 2 s) ──────────────────────
  // Built-in DCs keep their config in code; only user-created (_custom) DCs
  // push their structural config (dests/phases/settings/restrictions) so it
  // survives resets and reaches every device — the fix for the localStorage trap.
  function buildLiveConfig() {
    return {
      id:              DC_CONFIG.id,
      name:            DC_CONFIG.name,
      city:            DC_CONFIG.city || '',
      storagePrefix:   DC_CONFIG.storagePrefix,
      externalCarrier: DC_CONFIG.externalCarrier,
      optimizer:       DC_CONFIG.optimizer,
      restrictions:    DC_CONFIG.restrictions,
      settings:        state.settings,
      destinations:    state.destinations,
      phases:          state.phases,
      _custom:         !!DC_CONFIG._custom,   // false for built-in DCs (they stay code-defined)
    };
  }

  function queueConfigSync() {
    if (!DC_CONFIG) return;   // every DC (built-in + custom) syncs its structural config
    clearTimeout(_configTimer);
    _configTimer = setTimeout(_syncConfig, 2000);
  }

  async function _syncConfig() {
    if (!db || !_user || !DC_CONFIG) return;
    try {
      const cfg = buildLiveConfig();
      const { error } = await db.rpc('save_dc_config', {
        p_dc_slug: DC_CONFIG.id,
        p_config:  cfg,
      });
      if (error) throw error;
      // Custom DCs cache their whole config; built-in DCs stay code-defined and must NOT
      // enter the custom-DC cache (only their phases/dests sync, applied on pull).
      if (DC_CONFIG._custom) {
        const cache = JSON.parse(localStorage.getItem('_custom_dcs') || '{}');
        cache[DC_CONFIG.id] = cfg;
        localStorage.setItem('_custom_dcs', JSON.stringify(cache));
      }
      localStorage.setItem(DC_CONFIG.storagePrefix + '_cfgs